# Telegram bot tokenini @BotFather orqali oling
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenHereReplaceMe

# Groq API kalit(lar)i — https://console.groq.com/keys dan bepul olinadi.
# Bir nechta kalitni vergul bilan ajratib yozing — bot ular orasida
# navbat (round-robin) bilan so'rov yuboradi va limitlarni teng taqsimlaydi:
GROQ_API_KEYS=gsk_birinchiKalit,gsk_ikkinchiKalit,gsk_uchinchiKalit

# Eski usul (bitta kalit) — GROQ_API_KEYS bo'sh bo'lsa shu ishlatiladi:
# GROQ_API_KEY=gsk_exampleKeyHereReplaceMe

# Ixtiyoriy: Groq model nomi (bo'sh qoldirsa default ishlatiladi)
GROQ_MODEL=llama-3.3-70b-versatile

# Ixtiyoriy: har bir yaratilgan fayl va so'rov shu (xususiy) Telegram kanaliga
# log sifatida yuboriladi — "database" o'rnini bosadi. Botni kanalga ADMIN
# qilib qo'shing, so'ng kanal ID'sini shu yerga yozing (odatda -100 bilan
# boshlanadi). Bo'sh qoldirsangiz, bu funksiya ishlamaydi.
DB_CHANNEL_ID=-1001234567890

# Ixtiyoriy: yaratilgan fayllar saqlanadigan papka
OUTPUT_DIR=generated_files

# --- Ruxsat nazorati (whitelist + admin panel) ---
# Sizning (va boshqa adminlarning) Telegram user_id'lari — vergul bilan ajrating.
# O'z ID'ingizni bilish uchun Telegram'da @userinfobot ga yozing.
# Adminlar botdan CHEKSIZ foydalanadi va /admin panelga kira oladi.
ADMIN_USER_IDS=123456789

# Whitelist va foydalanish statistikasi saqlanadigan SQLite fayli nomi.
# DIQQAT: Render bepul rejasida bu fayl har qayta deploy/restart'da tozalanadi
# (persistent disk yo'q). Doimiy saqlash uchun pullik "Persistent Disk" kerak.
DB_PATH=bot_access.db
